<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="RT_E_TRAIN" Comment="Generation of a finite train of events">
	<Identification Description="Copyright (c) 2008 ACIN&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0"/>
	<VersionInfo Version="3.0" Author="Patrick Aigner" Date="2025-04-14" Remarks="changed package"/>
	<VersionInfo Organization="ACIN" Version="1.0" Author="Alois Zoitl" Date="2008-07-10"/>
	<CompilerInfo packageName="eclipse4diac::rtevents"/>
	<InterfaceList>
		<EventInputs>
			<Event Name="START" Type="Event">
				<With Var="DT"/>
				<With Var="N"/>
				<With Var="Deadline"/>
				<With Var="WCET"/>
			</Event>
			<Event Name="STOP" Type="Event"/>
		</EventInputs>
		<EventOutputs>
			<Event Name="EO" Type="Event" Comment="N events at period DT,starting at DT after START">
				<With Var="CV"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="DT" Type="TIME" Comment="Period between events"/>
			<VarDeclaration Name="N" Type="UINT" Comment="Number of events to generate"/>
			<VarDeclaration Name="Deadline" Type="TIME"/>
			<VarDeclaration Name="WCET" Type="TIME"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="CV" Type="UINT" Comment="EO index(0 N-1)"/>
		</OutputVars>
	</InterfaceList>
	<FBNetwork>
		<FB Name="RT_E_CYCLE" Type="eclipse4diac::rtevents::RT_E_CYCLE" x="1140" y="665"/>
		<FB Name="E_CTU" Type="iec61499::events::E_CTU" x="2470" y="1140"/>
		<FB Name="E_SWITCH" Type="iec61499::events::E_SWITCH" x="3895" y="950"/>
		<EventConnections>
			<Connection Source="RT_E_CYCLE.EO" Destination="E_CTU.CU"/>
			<Connection Source="START" Destination="E_CTU.R" dx1="1855"/>
			<Connection Source="STOP" Destination="RT_E_CYCLE.STOP" dx1="535"/>
			<Connection Source="E_CTU.RO" Destination="RT_E_CYCLE.START"/>
			<Connection Source="E_CTU.CUO" Destination="E_SWITCH.EI" dx1="770"/>
			<Connection Source="E_SWITCH.EO0" Destination="EO"/>
			<Connection Source="E_SWITCH.EO1" Destination="RT_E_CYCLE.STOP" dx1="345" dx2="-285" dy="-715"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="DT" Destination="RT_E_CYCLE.DT" dx1="355"/>
			<Connection Source="Deadline" Destination="RT_E_CYCLE.Deadline" dx1="250"/>
			<Connection Source="WCET" Destination="RT_E_CYCLE.WCET" dx1="175"/>
			<Connection Source="N" Destination="E_CTU.PV" dx1="135"/>
			<Connection Source="E_CTU.CV" Destination="CV" dx1="2300"/>
			<Connection Source="E_CTU.Q" Destination="E_SWITCH.G"/>
		</DataConnections>
	</FBNetwork>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
