<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="RT_E_SWITCH" Comment="Split an event to two event chain branches">
	<Identification Description="Copyright (c) 2008 ACIN&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0"/>
	<VersionInfo Version="3.0" Author="Patrick Aigner" Date="2025-04-14" Remarks="changed package"/>
	<VersionInfo Organization="ACIN" Version="1.0" Author="Alois Zoitl" Date="2008-07-10"/>
	<CompilerInfo packageName="eclipse4diac::rtevents"/>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="Event">
				<With Var="QI"/>
				<With Var="Tmin"/>
				<With Var="Deadline_EO1"/>
				<With Var="WCET_EO1"/>
				<With Var="Deadline_EO2"/>
				<With Var="WCET_EO2"/>
			</Event>
			<Event Name="EI" Type="Event" Comment="Input event">
				<With Var="G"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="Event">
				<With Var="QO"/>
			</Event>
			<Event Name="EO1" Type="Event" Comment="First output event"/>
			<Event Name="EO2" Type="Event" Comment="Second output event,etc."/>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL"/>
			<VarDeclaration Name="G" Type="BOOL"/>
			<VarDeclaration Name="Tmin" Type="TIME"/>
			<VarDeclaration Name="Deadline_EO1" Type="TIME"/>
			<VarDeclaration Name="WCET_EO1" Type="TIME"/>
			<VarDeclaration Name="Deadline_EO2" Type="TIME"/>
			<VarDeclaration Name="WCET_EO2" Type="TIME"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL"/>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
