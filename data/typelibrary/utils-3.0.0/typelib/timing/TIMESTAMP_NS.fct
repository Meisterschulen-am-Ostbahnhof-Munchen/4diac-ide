	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event">
				<With Var="startDate"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event">
				<With Var=""/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="startDate" Type="DT" InitialValue="DT#1970-01-01-00:00:00"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="" Type="ULINT"/>
		</OutputVars>
