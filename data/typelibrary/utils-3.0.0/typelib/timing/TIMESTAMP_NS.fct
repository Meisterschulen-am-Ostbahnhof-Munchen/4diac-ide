	<FunctionBody>
		<ST><![CDATA[FUNCTION TIMESTAMP_NS : ULINT
VAR_INPUT
	startDate : DT := DT#1970-01-01-00:00:00;
END_VAR
TIMESTAMP_NS := TIME_IN_NS_TO_ULINT(NOW() - startDate);
END_FUNCTION

]]></ST>
	</FunctionBody>
