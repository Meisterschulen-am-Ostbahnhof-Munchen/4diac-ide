<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="E_CTU" Comment="Event driven up counter">
	<Identification Standard="61499-1 Annex 2" Description="Copyright (c) 2017 fortiss GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0">
	</Identification>
	<VersionInfo Version="3.0" Author="Patrick Aigner" Date="2025-04-14" Remarks="changed package">
	</VersionInfo>
	<VersionInfo Organization="fortiss GmbH" Version="1.0" Author="Alois Zoitl" Date="2017-09-21" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<CompilerInfo packageName="iec61499::events">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="CU" Type="Event" Comment="Count up">
				<With Var="PV"/>
			</Event>
			<Event Name="R" Type="Event" Comment="Reset">
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CUO" Type="Event" Comment="Count up output">
				<With Var="Q"/>
				<With Var="CV"/>
			</Event>
			<Event Name="RO" Type="Event" Comment="Reset output">
				<With Var="Q"/>
				<With Var="CV"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="PV" Type="UINT" Comment="Process Value"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="Q" Type="BOOL" Comment="True if CV &gt;= PV"/>
			<VarDeclaration Name="CV" Type="UINT" Comment="Counter Value"/>
		</OutputVars>
	</InterfaceList>
	<BasicFB>
		<ECC>
			<ECState Name="START" Comment="Initial State" x="550" y="425">
			</ECState>
			<ECState Name="CU" Comment="Count Up" x="1570" y="165">
				<ECAction Algorithm="CU" Output="CUO"/>
			</ECState>
			<ECState Name="R" Comment="Reset" x="900" y="1000">
				<ECAction Algorithm="R" Output="RO"/>
			</ECState>
			<ECTransition Source="START" Destination="CU" Condition="CU[CV &lt; 65535]" x="970" y="210"/>
			<ECTransition Source="CU" Destination="START" Condition="1" x="1285" y="510"/>
			<ECTransition Source="START" Destination="R" Condition="R" x="845" y="770"/>
			<ECTransition Source="R" Destination="START" Condition="1" x="545" y="1050"/>
		</ECC>
		<Algorithm Name="R" Comment="reset counter">
			<ST><![CDATA[
CV := 0;
Q := FALSE;
]]></ST>
		</Algorithm>
		<Algorithm Name="CU" Comment="count up">
			<ST><![CDATA[
CV := CV + 1;
Q := (CV >= PV);
]]></ST>
		</Algorithm>
	</BasicFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
