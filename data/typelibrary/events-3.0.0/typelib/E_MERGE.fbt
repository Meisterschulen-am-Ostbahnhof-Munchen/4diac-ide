<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="E_MERGE" Comment="Merge (OR) of two input events">
	<Identification Standard="61499-1 Annex A" Function="Output EO is triggered when either EI1 or EI2 is received" Description="Copyright (c) 2017 fortiss GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0"/>
	<VersionInfo Version="3.0" Author="Patrick Aigner" Date="2025-04-14" Remarks="changed package"/>
	<VersionInfo Organization="fortiss GmbH" Version="1.0" Author="Alois Zoitl" Date="2017" Remarks="initial API and implementation and/or initial documentation"/>
	<CompilerInfo packageName="iec61499::events"/>
	<InterfaceList>
		<EventInputs>
			<Event Name="EI1" Type="Event" Comment="First input event"/>
			<Event Name="EI2" Type="Event" Comment="Second input event"/>
		</EventInputs>
		<EventOutputs>
			<Event Name="EO" Type="Event" Comment="Output Event"/>
		</EventOutputs>
	</InterfaceList>
	<BasicFB>
		<ECC>
			<ECState Name="START" Comment="Initial State" x="550" y="425"/>
			<ECState Name="EO" Comment="Issue EO Event" x="610" y="1025">
				<ECAction Output="EO"/>
			</ECState>
			<ECTransition Source="EO" Destination="START" Condition="1" x="690" y="805"/>
			<ECTransition Source="START" Destination="EO" Condition="EI1" x="405" y="765"/>
			<ECTransition Source="START" Destination="EO" Condition="EI2" x="910" y="785"/>
		</ECC>
	</BasicFB>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
