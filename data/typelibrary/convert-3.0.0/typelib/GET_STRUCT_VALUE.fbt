<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="GET_STRUCT_VALUE" Comment="Service Interface Function Block Type">
	<Identification Standard="61499-2" Description="Copyright (c) 2018 fortiss GmbH&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0"/>
	<VersionInfo Version="3.0" Author="Patrick Aigner" Date="2025-04-14" Remarks="changed package"/>
	<VersionInfo Version="1.0" Author="Jose Cabral" Date="2018-10-16"/>
	<CompilerInfo packageName="eclipse4diac::convert"/>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Get Value out of structure">
				<With Var="member"/>
				<With Var="in_struct"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="REQ event finished">
				<With Var="QO"/>
				<With Var="output"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="in_struct" Type="ANY" Comment="Structure to look into"/>
			<VarDeclaration Name="member" Type="STRING" Comment="Member of the strucuture to retrieve. Inner members are access using the dot (.) operator"/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="QO" Type="BOOL" Comment="TRUE if no errors ocurred, FALSE otherwise"/>
			<VarDeclaration Name="output" Type="ANY" Comment="Selected member if QO = TRUE, remains unchanged otherwise"/>
		</OutputVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
