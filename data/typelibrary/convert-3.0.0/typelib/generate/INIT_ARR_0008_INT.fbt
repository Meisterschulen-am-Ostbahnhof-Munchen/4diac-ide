<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="INIT_ARR_0008_INT" Comment="FB to make an Array (generic FB)">
	<Identification Standard="61499-2" Description="Copyright (c) 2026 Andreas Demmler Fahrzeugbau&#10; &#10;This program and the accompanying materials are made&#10;available under the terms of the Eclipse Public License 2.0&#10;which is available at https://www.eclipse.org/legal/epl-2.0/&#10;&#10;SPDX-License-Identifier: EPL-2.0 &#10;&#10;Can have a Initial Value e.g. [44, 0, 5, 0, 7, 8, 0, 0] on the Input of the in/out">
	</Identification>
	<VersionInfo Organization="Andreas Demmler Fahrzeugbau" Version="1.0" Author="Franz Höpfinger" Date="2026-01-22">
	</VersionInfo>
	<CompilerInfo packageName="eclipse4diac::convert::generate">
	</CompilerInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="INIT" Type="EInit" Comment="Service Initialization">
				<With Var="D1"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="INITO" Type="EInit" Comment="Initialization Confirm">
				<With Var="u16DaSize"/>
				<With Var="D1"/>
			</Event>
		</EventOutputs>
		<OutputVars>
			<VarDeclaration Name="u16DaSize" Type="UINT" Comment="Data length in Array Elements"/>
		</OutputVars>
		<InOutVars>
			<VarDeclaration Name="D1" Type="INT" Comment="Array in/out" ArraySize="0..7"/>
		</InOutVars>
	</InterfaceList>
	<Attribute Name="eclipse4diac::core::GenericClassName" Value="'GEN_INIT_ARR'"/>
	<Attribute Name="eclipse4diac::core::TypeHash" Value="''"/>
</FBType>
